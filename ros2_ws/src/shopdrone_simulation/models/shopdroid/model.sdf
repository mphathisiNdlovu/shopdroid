        <geometry>
          <cylinder><radius>0.016</radius><length>0.50</length></cylinder>
        </geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <!-- 4 Vertical Uprights -->
      <visual name="upright_fl">
        <pose>0.33 0.25 0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.26</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
