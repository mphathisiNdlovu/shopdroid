        <pose>-0.41 -0.25 0.32 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.26</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>

      <!-- ==================================================== -->
      <!-- PERCEPTION & SENSOR MAST                             -->
      <!-- ==================================================== -->
      <!-- Roof 3D LiDAR Sensor Tower (360-degree range) -->
      <visual name="lidar_riser">
        <pose>0.15 0 0.49 0 0 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.10</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="lidar_puck">
        <pose>0.15 0 0.55 0 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.06</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.3 0.6 1</ambient>
          <diffuse>0.15 0.4 0.8 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0.15 0 0.56 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>35.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>/shopdroid/lidar</topic>
      </sensor>

      <!-- Forward Stereoscopic Vision Camera Turret -->
      <visual name="camera_housing">
        <pose>0.46 0 0.30 0 0 0</pose>
        <geometry><box><size>0.06 0.16 0.06</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
      <visual name="camera_lens_l">
        <pose>0.492 0.05 0.30 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0 0.4 0.9 1</ambient><diffuse>0 0.5 1 1</diffuse></material>
      </visual>
      <visual name="camera_lens_r">
        <pose>0.492 -0.05 0.30 0 1.5708 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0 0.4 0.9 1</ambient><diffuse>0 0.5 1 1</diffuse></material>
      </visual>

      <sensor name="camera" type="camera">
        <pose>0.49 0 0.30 0 0 0</pose>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>/shopdroid/camera/image_raw</topic>
      </sensor>

      <!-- High-Precision RTK GPS Saucer & GSM/LoRa Telemetry Antenna -->
