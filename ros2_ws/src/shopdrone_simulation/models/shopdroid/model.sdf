<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="shopdroid">
    <static>false</static>
    <pose>0 0 0.22 0 0 0</pose>

    <!-- ==================================================== -->
    <!-- MAIN GROUND DROID CHASSIS & ROLL CAGE                -->
    <!-- ==================================================== -->
    <link name="base_link">
      <inertial>
        <mass>26.0</mass>
        <pose>0 0 0.06 0 0 0</pose>
        <inertia>
          <ixx>0.75</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.65</iyy>
          <iyz>0</iyz>
          <izz>2.10</izz>
        </inertia>
      </inertial>

      <!-- Main Lower All-Terrain Armored Hull -->
      <visual name="chassis_hull">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box><size>0.92 0.54 0.22</size></box>
        </geometry>
        <material>
          <ambient>0.22 0.24 0.25 1</ambient>
          <diffuse>0.26 0.28 0.30 1</diffuse>
          <specular>0.6 0.6 0.65 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/container_metal.png</albedo_map>
              <roughness>0.4</roughness>
              <metalness>0.7</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="chassis_col">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box><size>0.92 0.54 0.22</size></box>
        </geometry>
      </collision>

      <!-- Rugged Front Push Bumper / Bull Bar -->
      <visual name="front_bullbar">
        <pose>0.48 0 0.12 0 0 0</pose>
        <geometry>
          <box><size>0.10 0.62 0.16</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>
      <collision name="bullbar_col">
        <pose>0.48 0 0.12 0 0 0</pose>
        <geometry>
          <box><size>0.10 0.62 0.16</size></box>
        </geometry>
      </collision>

      <!-- Front Underbody Rock Skid Plate -->
      <visual name="skid_plate">
        <pose>0.42 0 0.02 0 0.32 0</pose>
        <geometry>
          <box><size>0.26 0.48 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.32 1</ambient>
          <diffuse>0.35 0.35 0.38 1</diffuse>
        </material>
      </visual>

      <!-- High-Intensity Forward Headlights / Night Floodlights -->
      <visual name="headlight_left">
        <pose>0.49 0.20 0.16 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>1.0 1.0 0.9 1</ambient>
          <diffuse>1.0 1.0 0.9 1</diffuse>
          <emissive>1.0 1.0 0.9 1</emissive>
        </material>
      </visual>
      <visual name="headlight_right">
        <pose>0.49 -0.20 0.16 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.04</radius><length>0.03</length></cylinder>
        </geometry>
        <material>
          <ambient>1.0 1.0 0.9 1</ambient>
          <diffuse>1.0 1.0 0.9 1</diffuse>
          <emissive>1.0 1.0 0.9 1</emissive>
        </material>
      </visual>

      <!-- High-Vis Center Lightbar -->
      <visual name="floodlight_bar">
        <pose>0.45 0 0.22 0 0 0</pose>
        <geometry>
          <box><size>0.04 0.32 0.035</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.95 1.0 1</ambient>
          <diffuse>0.9 0.95 1.0 1</diffuse>
          <emissive>0.9 0.95 1.0 1</emissive>
        </material>
      </visual>

      <!-- Rear Red Brake & Hazard Indicators -->
      <visual name="taillight_left">
        <pose>-0.47 0.22 0.14 0 0 0</pose>
        <geometry>
          <box><size>0.03 0.08 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.05 1</ambient>
          <diffuse>0.9 0.1 0.05 1</diffuse>
          <emissive>0.9 0.1 0.05 1</emissive>
        </material>
      </visual>
      <visual name="taillight_right">
        <pose>-0.47 -0.22 0.14 0 0 0</pose>
        <geometry>
          <box><size>0.03 0.08 0.05</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.05 1</ambient>
          <diffuse>0.9 0.1 0.05 1</diffuse>
          <emissive>0.9 0.1 0.05 1</emissive>
        </material>
      </visual>

      <!-- ==================================================== -->
      <!-- SECURE OTP DIGITAL CARGO PAYLOAD VAULT (SRS 4.8)     -->
      <!-- ==================================================== -->
      <!-- Weatherproof Central Cargo Container -->
      <visual name="cargo_vault">
        <pose>-0.06 0 0.28 0 0 0</pose>
        <geometry>
          <box><size>0.50 0.42 0.24</size></box>
        </geometry>
        <material>
          <ambient>0.85 0.50 0.10 1</ambient>
          <diffuse>0.92 0.55 0.12 1</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/cargo_box.png</albedo_map>
              <roughness>0.3</roughness>
              <metalness>0.4</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="cargo_vault_col">
        <pose>-0.06 0 0.28 0 0 0</pose>
        <geometry>
          <box><size>0.50 0.42 0.24</size></box>
        </geometry>
      </collision>

      <!-- High-Security Solenoid Lock Lid Rim -->
      <visual name="cargo_lid">
        <pose>-0.06 0 0.41 0 0 0</pose>
        <geometry>
          <box><size>0.52 0.44 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <!-- Customer 4-Digit Digital PIN Keypad Panel (SRS Section 4.8) -->
      <visual name="keypad_console">
        <pose>0.12 0.215 0.32 0 0 1.5708</pose>
        <geometry>
          <box><size>0.12 0.09 0.015</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <!-- Keypad Digital Status Light (Green / Locked Secure) -->
      <visual name="keypad_status_led">
        <pose>0.12 0.225 0.36 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.008</radius><length>0.01</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 1.0 0.2 1</ambient>
          <diffuse>0.1 1.0 0.2 1</diffuse>
          <emissive>0.1 1.0 0.2 1</emissive>
        </material>
      </visual>

      <!-- ==================================================== -->
      <!-- EXOSKELETON TUBULAR ROLL CAGE & ROOF RACK            -->
      <!-- ==================================================== -->
      <!-- Left Upper Rail -->
      <visual name="rollcage_left_top">
        <pose>-0.04 0.25 0.45 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.016</radius><length>0.76</length></cylinder>
        </geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <!-- Right Upper Rail -->
      <visual name="rollcage_right_top">
        <pose>-0.04 -0.25 0.45 0 1.5708 0</pose>
        <geometry>
          <cylinder><radius>0.016</radius><length>0.76</length></cylinder>
        </geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
