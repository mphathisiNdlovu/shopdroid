<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="rural_zimbabwe">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Harmonic Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>



    <!-- Daytime African Atmosphere (Safe for Intel Integrated Graphics) -->
    <scene>
      <ambient>0.75 0.75 0.75 1.0</ambient>
      <background>0.58 0.78 0.95 1.0</background>
      <shadows>false</shadows>
      <grid>true</grid>
    </scene>

    <!-- Warm African Sun Illuminator -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 60 0 0 0</pose>
      <diffuse>1.0 0.98 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.45 0.25 -0.85</direction>
    </light>

    <!-- ==================================================== -->
    <!-- RURAL SAVANNAH TERRAIN & RED DIRT ROADS              -->
    <!-- ==================================================== -->
    <!-- African Savannah Ground Plane -->
    <model name="savannah_terrain">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_col">
          <geometry>
            <plane><normal>0 0 1</normal><size>250 250</size></plane>
          </geometry>
        </collision>
        <visual name="ground_vis">
          <geometry>
            <plane><normal>0 0 1</normal><size>250 250</size></plane>
          </geometry>
          <material>
            <ambient>0.65 0.48 0.32 1</ambient>
            <diffuse>0.68 0.50 0.35 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Rural Dirt Road connecting Hub to Homestead -->
    <model name="dirt_road_track">
      <static>true</static>
      <pose>10.0 -3.0 0.005 0 0 0.1</pose>
      <link name="road_link">
        <visual name="road_vis">
          <geometry>
            <plane><normal>0 0 1</normal><size>60 4.5</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>materials/textures/dirt_road.png</albedo_map>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================================================== -->
    <!-- SHOP HUB LOGISTICS BASE STATION (Origin: 0, 0, 0)    -->
    <!-- ==================================================== -->
    <!-- High-Visibility Helipad Launchpad Deck -->
    <model name="hub_launchpad">
      <static>true</static>
      <pose>0 0 0.015 0 0 0</pose>
      <link name="pad_link">
        <collision name="pad_col">
          <geometry><box><size>3.6 3.6 0.03</size></box></geometry>
        </collision>
        <visual name="pad_surface">
          <geometry><box><size>3.6 3.6 0.03</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <pbr>
              <metal>
                <albedo_map>materials/textures/helipad_hub.png</albedo_map>
                <roughness>0.5</roughness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- 4 Corner Solar Runway Beacons (Green Navigation Lights) -->
        <visual name="beacon_ne">
          <pose>1.7 1.7 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0 1 0.2 1</ambient><diffuse>0 1 0.2 1</diffuse><emissive>0 1 0.2 1</emissive></material>
        </visual>
        <visual name="beacon_nw">
          <pose>1.7 -1.7 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0 1 0.2 1</ambient><diffuse>0 1 0.2 1</diffuse><emissive>0 1 0.2 1</emissive></material>
        </visual>
        <visual name="beacon_se">
          <pose>-1.7 1.7 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0 1 0.2 1</ambient><diffuse>0 1 0.2 1</diffuse><emissive>0 1 0.2 1</emissive></material>
        </visual>
        <visual name="beacon_sw">
          <pose>-1.7 -1.7 0.05 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.10</length></cylinder></geometry>
          <material><ambient>0 1 0.2 1</ambient><diffuse>0 1 0.2 1</diffuse><emissive>0 1 0.2 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Shop Hub Distribution Depot (20ft Container Architecture) -->
    <model name="shop_hub_depot">
      <static>true</static>
      <pose>-4.2 0 1.3 0 0 0</pose>
      <link name="depot_link">
        <collision name="depot_col">
          <geometry><box><size>3.2 6.0 2.6</size></box></geometry>
        </collision>
        <visual name="container_vis">
          <geometry><box><size>3.2 6.0 2.6</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>materials/textures/container_metal.png</albedo_map>
                <roughness>0.4</roughness>
                <metalness>0.7</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- Loading Dock Awning Roof -->
        <visual name="dock_awning">
          <pose>1.8 0 1.35 0 0.1 0</pose>
          <geometry><box><size>1.6 4.8 0.08</size></box></geometry>
          <material><ambient>0.2 0.25 0.3 1</ambient><diffuse>0.25 0.3 0.35 1</diffuse></material>
        </visual>
        <!-- Steel Support Pillars for Awning -->
        <visual name="awning_post_1">
          <pose>2.5 2.2 0 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
        <visual name="awning_post_2">
          <pose>2.5 -2.2 0 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Solar Microgrid Power Canopy (SRS 2.1 Clean Energy Autonomy) -->
    <model name="solar_microgrid">
      <static>true</static>
      <pose>-4.2 0 2.95 0 -0.25 0</pose>
      <link name="solar_link">
        <collision name="solar_col">
          <geometry><box><size>3.0 5.4 0.1</size></box></geometry>
        </collision>
        <visual name="solar_panel_array">
          <geometry><box><size>3.0 5.4 0.1</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.8 0.8 0.9 1</specular>
            <pbr>
              <metal>
                <albedo_map>materials/textures/solar_panel.png</albedo_map>
                <roughness>0.2</roughness>
                <metalness>0.4</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Weather Station Mast & RTK GPS Tower -->
    <model name="weather_station_mast">
      <static>true</static>
      <pose>-1.8 3.2 2.5 0 0 0</pose>
      <link name="mast_link">
        <!-- Vertical Tower Pole -->
        <visual name="tower_pole">
          <geometry><cylinder><radius>0.05</radius><length>5.0</length></cylinder></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
        <!-- RTK Differential GPS Base Receiver -->
        <visual name="rtk_base_dome">
          <pose>0 0 2.55 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <!-- Aviation Windsock Arm & Striped Cone -->
        <visual name="windsock_boom">
          <pose>0.4 0 2.1 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.02</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="windsock_cone">
          <pose>0.8 0 1.95 0 0.3 0</pose>
          <geometry><cone><radius>0.15</radius><length>0.9</length></cone></geometry>
          <material><ambient>0.9 0.2 0.1 1</ambient><diffuse>1.0 0.25 0.1 1</diffuse></material>
        </visual>
        <!-- Anemometer Wind Cups -->
        <visual name="anemometer_hub">
          <pose>-0.3 0 2.3 0 0 0</pose>
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Hub Security Perimeter Fence (South & North boundaries) -->
    <model name="hub_fence_north">
      <static>true</static>
      <pose>-1.5 4.5 0.6 0 0 0</pose>
      <link name="fence_n_link">
        <visual name="fence_n_vis">
          <geometry><box><size>7.0 0.08 1.2</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 0.7</ambient><diffuse>0.5 0.5 0.5 0.7</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="hub_fence_south">
      <static>true</static>
      <pose>-1.5 -4.5 0.6 0 0 0</pose>
      <link name="fence_s_link">
        <visual name="fence_s_vis">
          <geometry><box><size>7.0 0.08 1.2</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 0.7</ambient><diffuse>0.5 0.5 0.5 0.7</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================================================== -->
    <!-- RURAL HOMESTEAD & DELIVERY TARGET (Target: 15, 0, 0) -->
    <!-- ==================================================== -->
    <!-- Customer Demarcated Safe Landing Target (SRS 4.8) -->
    <model name="customer_landing_target">
      <static>true</static>
      <pose>15.0 0 0.015 0 0 0</pose>
      <link name="target_link">
        <collision name="target_col">
          <geometry><box><size>2.8 2.8 0.03</size></box></geometry>
        </collision>
        <visual name="target_visual">
          <geometry><box><size>2.8 2.8 0.03</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.95 0.95 0.95 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>materials/textures/customer_pad.png</albedo_map>
                <roughness>0.6</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <!-- 4 Corner Touchdown Guide Beacons -->
        <visual name="c_beacon_1">
          <pose>1.3 1.3 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse><emissive>1 0.8 0 1</emissive></material>
        </visual>
        <visual name="c_beacon_2">
          <pose>1.3 -1.3 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse><emissive>1 0.8 0 1</emissive></material>
        </visual>
        <visual name="c_beacon_3">
          <pose>-1.3 1.3 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse><emissive>1 0.8 0 1</emissive></material>
        </visual>
        <visual name="c_beacon_4">
          <pose>-1.3 -1.3 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>1 0.8 0 1</ambient><diffuse>1 0.8 0 1</diffuse><emissive>1 0.8 0 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Main Traditional Zimbabwean Rondavel (Indlu / Imba) -->
    <model name="main_rondavel">
      <static>true</static>
      <pose>18.5 4.5 0 0 0 0</pose>
      <link name="rondavel_link">
        <!-- Stone & Clay Whitewashed Cylindrical Wall -->
        <collision name="wall_col">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry><cylinder><radius>2.2</radius><length>2.5</length></cylinder></geometry>
        </collision>
        <visual name="wall_vis">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry><cylinder><radius>2.2</radius><length>2.5</length></cylinder></geometry>
          <material>
            <ambient>0.85 0.8 0.75 1</ambient>
            <diffuse>0.9 0.85 0.8 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>materials/textures/mud_stone_wall.png</albedo_map>
                <roughness>0.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- Conical Combed Thatch Straw Roof (SRS Traditional Architecture) -->
        <collision name="roof_col">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><cone><radius>2.7</radius><length>1.8</length></cone></geometry>
        </collision>
        <visual name="thatch_roof_vis">
          <pose>0 0 3.2 0 0 0</pose>
          <geometry><cone><radius>2.7</radius><length>1.8</length></cone></geometry>
          <material>
            <ambient>0.8 0.65 0.4 1</ambient>
            <diffuse>0.9 0.75 0.5 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>materials/textures/thatch_straw.png</albedo_map>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- Thatch Apex Finial Pole -->
        <visual name="finial_pole">
          <pose>0 0 4.2 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>

        <!-- Wooden Veranda Entry Pillars -->
        <visual name="veranda_pillar_1">
          <pose>-1.4 -1.8 1.1 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>2.2</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <visual name="veranda_pillar_2">
          <pose>1.4 -1.8 1.1 0 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>2.2</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Traditional Kitchen Rondavel (Ixhiba) -->
    <model name="kitchen_rondavel">
      <static>true</static>
      <pose>23.0 1.5 0 0 0 0</pose>
      <link name="kitchen_link">
        <collision name="k_wall_col">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry><cylinder><radius>1.6</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="k_wall_vis">
          <pose>0 0 1.0 0 0 0</pose>
          <geometry><cylinder><radius>1.6</radius><length>2.0</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.75 0.7 1</ambient>
            <diffuse>0.85 0.8 0.75 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>materials/textures/mud_stone_wall.png</albedo_map>
                <roughness>0.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
        <visual name="k_roof_vis">
          <pose>0 0 2.5 0 0 0</pose>
          <geometry><cone><radius>2.0</radius><length>1.4</length></cone></geometry>
          <material>
            <ambient>0.8 0.65 0.4 1</ambient>
            <diffuse>0.9 0.75 0.5 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>materials/textures/thatch_straw.png</albedo_map>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Traditional Elevated Granary on Stilts (Dura / Isiphala) -->
    <model name="traditional_granary">
      <static>true</static>
      <pose>21.0 -4.5 0 0 0 0.4</pose>
      <link name="granary_link">
        <!-- 4 Elevated Timber Stilts -->
        <visual name="stilt_1">
          <pose>0.6 0.6 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <visual name="stilt_2">
          <pose>-0.6 0.6 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <visual name="stilt_3">
          <pose>0.6 -0.6 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <visual name="stilt_4">
          <pose>-0.6 -0.6 0.5 0 0 0</pose>
          <geometry><cylinder><radius>0.06</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.4 0.25 0.15 1</diffuse></material>
        </visual>
        <!-- Elevated Timber Floor & Basket Body -->
        <collision name="granary_col">
          <pose>0 0 1.6 0 0 0</pose>
          <geometry><cylinder><radius>1.1</radius><length>1.3</length></cylinder></geometry>
        </collision>
        <visual name="granary_body">
          <pose>0 0 1.6 0 0 0</pose>
          <geometry><cylinder><radius>1.1</radius><length>1.3</length></cylinder></geometry>
          <material><ambient>0.45 0.3 0.15 1</ambient><diffuse>0.55 0.38 0.2 1</diffuse></material>
        </visual>
        <!-- Thatch Cap -->
        <visual name="granary_thatch">
          <pose>0 0 2.6 0 0 0</pose>
          <geometry><cone><radius>1.35</radius><length>0.9</length></cone></geometry>
          <material><ambient>0.8 0.65 0.4 1</ambient><diffuse>0.9 0.75 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rural Solar Borehole Water Station -->
    <model name="solar_borehole_tank">
      <static>true</static>
      <pose>16.0 8.0 0 0 0 0</pose>
      <link name="tank_link">
        <!-- Steel Tower Stand -->
        <visual name="tower_leg_1">
          <pose>0.5 0.5 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.6 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
        <visual name="tower_leg_2">
          <pose>-0.5 0.5 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.6 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
        <visual name="tower_leg_3">
          <pose>0.5 -0.5 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.6 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
        <visual name="tower_leg_4">
          <pose>-0.5 -0.5 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.04</radius><length>3.0</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.6 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material>
        </visual>
        <!-- 5000L Green Polyethylene Water Tank -->
        <collision name="tank_col">
          <pose>0 0 3.8 0 0 0</pose>
          <geometry><cylinder><radius>0.75</radius><length>1.6</length></cylinder></geometry>
        </collision>
        <visual name="tank_vis">
          <pose>0 0 3.8 0 0 0</pose>
          <geometry><cylinder><radius>0.75</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.1 0.45 0.2 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material>
        </visual>
        <!-- Solar Water Pump Panel -->
        <visual name="pump_solar">
          <pose>0 0 4.7 0 -0.4 0</pose>
          <geometry><box><size>0.9 1.4 0.05</size></box></geometry>
          <material><ambient>0.1 0.2 0.5 1</ambient><diffuse>0.15 0.25 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cattle Kraal / Livestock Pen (Isibaya / Danga) -->
    <model name="cattle_kraal">
      <static>true</static>
      <pose>24.0 -8.0 0 0 0 0</pose>
      <link name="kraal_link">
        <!-- Circular Wooden Timber Enclosure -->
        <visual name="kraal_fence">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>3.5</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.35 0.25 0.15 0.6</ambient><diffuse>0.4 0.3 0.2 0.6</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================================================== -->
    <!-- NATURAL SAVANNAH VEGETATION & TERRAIN OBSTACLES      -->
    <!-- ==================================================== -->
    <!-- Flight Corridor / Ground Obstacle Tree (Acacia Tortilis) -->
    <model name="obstacle_tree">
      <static>true</static>
      <pose>7.5 1.5 0 0 0 0.8</pose>
      <link name="tree_link">
        <collision name="trunk_col">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>4.5</length></cylinder></geometry>
        </collision>
        <visual name="trunk_vis">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>4.5</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.35 0.25 0.15 1</diffuse>
          </material>
        </visual>
        <!-- Distinctive Umbrella Thorn Acacia Flat-Top Canopy -->
        <collision name="canopy_col">
          <pose>0 0 5.2 0 0 0</pose>
          <geometry><cylinder><radius>3.2</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="canopy_vis_lower">
          <pose>0 0 4.8 0 0 0</pose>
          <geometry><cylinder><radius>2.8</radius><length>0.6</length></cylinder></geometry>
          <material>
            <ambient>0.22 0.45 0.18 1</ambient>
            <diffuse>0.28 0.52 0.22 1</diffuse>
          </material>
        </visual>
        <visual name="canopy_vis_upper">
          <pose>0 0 5.3 0 0 0</pose>
          <geometry><cylinder><radius>3.4</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.48 0.20 1</ambient>
            <diffuse>0.30 0.55 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Second Acacia Tree along Southern Path -->
    <model name="acacia_tree_south">
      <static>true</static>
      <pose>11.0 -7.0 0 0 0 2.1</pose>
      <link name="acacia_s_link">
        <collision name="s_trunk_col">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>4.5</length></cylinder></geometry>
        </collision>
        <visual name="s_trunk_vis">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><cylinder><radius>0.35</radius><length>4.5</length></cylinder></geometry>
          <material>
            <ambient>0.3 0.2 0.1 1</ambient>
            <diffuse>0.35 0.25 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="s_canopy_col">
          <pose>0 0 5.0 0 0 0</pose>
          <geometry><cylinder><radius>2.8</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="s_canopy_vis">
          <pose>0 0 5.0 0 0 0</pose>
          <geometry><cylinder><radius>2.8</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.25 0.45 0.2 1</ambient>
            <diffuse>0.3 0.55 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Matobo Granite Kopje (Balancing Rocks Formation) -->
    <model name="matobo_kopje">
      <static>true</static>
      <pose>22.0 -16.0 0 0 0 0.5</pose>
      <link name="kopje_link">
        <collision name="kopje_base_col">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><box><size>5.5 5.0 3.6</size></box></geometry>
        </collision>
        <visual name="kopje_base_vis">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><box><size>5.5 5.0 3.6</size></box></geometry>
          <material>
            <ambient>0.5 0.48 0.45 1</ambient>
            <diffuse>0.58 0.55 0.52 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <!-- Top Balancing Boulder -->
        <collision name="kopje_top_col">
          <pose>0.2 0.3 4.2 0.1 -0.15 0.4</pose>
          <geometry><box><size>3.8 3.2 2.4</size></box></geometry>
        </collision>
        <visual name="kopje_top_vis">
          <pose>0.2 0.3 4.2 0.1 -0.15 0.4</pose>
          <geometry><box><size>3.8 3.2 2.4</size></box></geometry>
          <material>
            <ambient>0.55 0.52 0.48 1</ambient>
            <diffuse>0.62 0.60 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================================================== -->
    <!-- SHOPDROID ALL-TERRAIN TERRESTRIAL DELIVERY DROID     -->
    <!-- Pre-spawned on Hub Deck (0, 0, 0.22)                 -->
